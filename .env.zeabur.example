# Zeabur Deployment Environment Variables
# Copy these to your Zeabur service environment variable settings

# =============================================================================
# REQUIRED: LLM PROVIDER CONFIGURATION
# =============================================================================
# Choose ONE LLM provider and uncomment the corresponding section:

# Option 1: OpenAI (已禁用，使用 Gemini)
# ENABLE_OPENAI=true
# LLM_KEY=OPENAI_GPT4O
# OPENAI_API_KEY=your_openai_api_key_here
# SECONDARY_LLM_KEY=OPENAI_GPT4O_MINI  # Optional: cheaper model for simple tasks

# Option 2: Anthropic Claude
# ENABLE_ANTHROPIC=true
# LLM_KEY=ANTHROPIC_CLAUDE3.5_SONNET
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: Azure OpenAI
# ENABLE_AZURE=true
# LLM_KEY=AZURE_OPENAI
# AZURE_DEPLOYMENT=your_deployment_name
# AZURE_API_KEY=your_azure_api_key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-08-01-preview

# Option 4: Gemini (推荐使用 Gemini 3 Flash)
ENABLE_GEMINI=true
LLM_KEY=GEMINI_3_FLASH
GEMINI_API_KEY=AIzaSyAm6ndM0zlOG0Ec-rgVj71taMtdgECvnXI

# 其他 Gemini 模型选项:
# LLM_KEY=GEMINI_2.5_PRO_PREVIEW  # Gemini 2.5 Pro
# LLM_KEY=GEMINI_2.5_FLASH        # Gemini 2.5 Flash

# =============================================================================
# BROWSER CONFIGURATION
# =============================================================================
BROWSER_TYPE=chromium-headful
ENABLE_CODE_BLOCK=true
MAX_SCRAPING_RETRIES=0
BROWSER_ACTION_TIMEOUT_MS=5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# NOTE: Zeabur auto-configures DATABASE_STRING when you add PostgreSQL service
# You typically don't need to set this manually
# DATABASE_STRING will be automatically injected by Zeabur

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENV=production
LOG_LEVEL=INFO
MAX_STEPS_PER_RUN=50

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Analytics (set to your UUID or leave as anonymous)
ANALYTICS_ID=anonymous

# Enable log artifacts (increases storage usage)
# ENABLE_LOG_ARTIFACTS=false

# =============================================================================
# STORAGE PATHS (Pre-configured for container, don't change)
# =============================================================================
VIDEO_PATH=/data/videos
HAR_PATH=/data/har
LOG_PATH=/data/log
ARTIFACT_STORAGE_PATH=/data/artifacts

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# NOTE: Zeabur automatically provides PORT environment variable
# The boot.sh script will read it and configure services accordingly
# You don't need to set PORT manually

# =============================================================================
# BITWARDEN INTEGRATION (Optional)
# =============================================================================
# Uncomment if using Bitwarden for credential management
# SKYVERN_AUTH_BITWARDEN_ORGANIZATION_ID=your-org-id
# SKYVERN_AUTH_BITWARDEN_CLIENT_ID=user.your-client-id
# SKYVERN_AUTH_BITWARDEN_CLIENT_SECRET=your-client-secret
# SKYVERN_AUTH_BITWARDEN_MASTER_PASSWORD=your-master-password

# =============================================================================
# 1PASSWORD INTEGRATION (Optional)
# =============================================================================
# Uncomment if using 1Password for credential management
# OP_SERVICE_ACCOUNT_TOKEN=your_1password_token
