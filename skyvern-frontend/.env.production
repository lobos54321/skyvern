# Production environment configuration for Zeabur deployment
# Using relative URLs because nginx reverse proxy handles routing

# API Base URL - nginx proxies /api/* to backend:8000
VITE_API_BASE_URL=/api/v1

# Artifact API Base URL - nginx proxies /artifacts/* to artifact server:9090
VITE_ARTIFACT_API_BASE_URL=/artifacts

# WebSocket URL - nginx handles WebSocket upgrade for /api/*
VITE_WSS_BASE_URL=/api/v1

# Enable code block node
VITE_ENABLE_CODE_BLOCK=true

# Disable log artifacts by default in production
VITE_ENABLE_LOG_ARTIFACTS=false

# Environment name
VITE_ENVIRONMENT=production
